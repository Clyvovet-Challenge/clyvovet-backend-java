# Nada aqui entra na imagem -- o Dockerfile so copia pom.xml e src/. O que este
# arquivo evita e o passo anterior: sem ele o Docker envia o diretorio inteiro
# (~89 MB, quase tudo target/ e documentos/) ao daemon a cada build, so para
# depois usar meio mega.

# Saidas de build e do grafo do codebase
target/
graphify-out/

# Historico e configuracao de ferramentas
.git/
.gitignore
.gitattributes
.graphifyignore
.idea/
.vscode/
.claude/
.junie/

# Documentacao e material de entrega
docs/
documentos/
specs/
*.md

# Scripts que rodam fora do container
deploy.sh
docker-compose.yml
scripts/
