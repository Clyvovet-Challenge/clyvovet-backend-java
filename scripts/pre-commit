#!/bin/sh
# Avisa quando os nomes curados das comunidades do grafo sairam do lugar.
#
# O rebuild do graphify roda em segundo plano depois de cada commit, entao nao
# da para encadear a correcao no post-commit: quando ele termina, o hook ja
# saiu ha muito tempo. O aviso vem no commit seguinte, que e quando o resultado
# do rebuild anterior ja esta em disco.
#
# Nunca bloqueia o commit -- so diz o que rodar.
#
# Instale com:  cp scripts/pre-commit .git/hooks/pre-commit

[ "${GRAPHIFY_SKIP_HOOK:-0}" = "1" ] && exit 0
[ -f graphify-out/graph.json ] || exit 0
[ -f scripts/label-communities.py ] || exit 0

# Mesma ordem de deteccao do hook do graphify: o interpretador anotado primeiro,
# porque `python` pode nem estar no PATH de clientes graficos de git.
_py=""
if [ -f graphify-out/.graphify_python ]; then
    _py=$(tr -d '[:space:]' < graphify-out/.graphify_python 2>/dev/null)
fi
if [ ! -x "$_py" ]; then
    _py=$(command -v python3 2>/dev/null || command -v python 2>/dev/null)
fi
[ -n "$_py" ] || exit 0

if ! _saida=$("$_py" scripts/label-communities.py --check 2>&1); then
    echo "$_saida" | grep 'sem correspondencia\|nao curado' | tail -n 8
    echo "[graphify] para devolver os nomes curados:"
    echo "[graphify]   python scripts/label-communities.py && graphify cluster-only ."
fi

exit 0
