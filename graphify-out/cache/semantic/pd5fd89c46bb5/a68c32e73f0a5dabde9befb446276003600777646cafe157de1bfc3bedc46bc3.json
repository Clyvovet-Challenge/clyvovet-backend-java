{"nodes": [{"id": "docs_01_arquitetura_arquitetura_em_camadas", "label": "Arquitetura em Camadas", "file_type": "concept", "source_file": "docs/01-arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Controller -> Service -> Repository -> Entity, sem desvios. Controller nao tem regra de negocio; toda a logica e resolucao de FK mora no service."}, {"id": "docs_01_arquitetura_fluxo_de_requisicao", "label": "Fluxo de Requisicao", "file_type": "concept", "source_file": "docs/01-arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Leitura passa por cache antes do repositorio; escrita valida com @Valid antes de chamar o service, entao um payload invalido nunca alcanca a camada de negocio."}, {"id": "docs_01_arquitetura_cache_caffeine", "label": "Cache Caffeine", "file_type": "concept", "source_file": "docs/01-arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ConcurrentMapCacheManager padrao foi trocado por Caffeine (TTL 10 min, teto de 1.000 entradas) porque o default nao tem nenhum dos dois limites e, com tutorId na chave, o numero de combinacoes cresce junto com a base de usuarios."}, {"id": "docs_01_arquitetura_chave_de_cache", "label": "Chave de Cache das Listagens", "file_type": "concept", "source_file": "docs/01-arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chave = filtros + paginacao. So listagens sao cacheadas; buscarPorId vai ao banco toda vez."}, {"id": "docs_01_arquitetura_invalidacao_all_entries", "label": "Invalidacao allEntries", "file_type": "rationale", "source_file": "docs/01-arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Qualquer escrita descarta o cache inteiro da entidade. E a estrategia mais simples e mais segura contra entradas orfas."}, {"id": "docs_01_arquitetura_filtro_opcional_jpql", "label": "Filtro Opcional JPQL", "file_type": "concept", "source_file": "docs/01-arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O padrao ':param IS NULL OR ...' faz o filtro desaparecer quando nao informado, evitando Specifications ou Criteria API. Uma query cobre as 4 combinacoes."}, {"id": "docs_01_arquitetura_mappers_manuais", "label": "Mappers Manuais", "file_type": "rationale", "source_file": "docs/01-arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Componentes Spring escritos a mao, nao MapStruct, apesar do nome do pacote. Zero geracao de codigo; mais verboso, mas explicito."}, {"id": "docs_01_arquitetura_tratamento_global_de_erros", "label": "Tratamento Global de Erros", "file_type": "concept", "source_file": "docs/01-arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "@ControllerAdvice. O handler de 404 existe porque, sem ele, o Spring devolveria 500 para EntityNotFoundException."}, {"id": "docs_01_arquitetura_uuid_como_pk", "label": "UUID como Chave Primaria", "file_type": "rationale", "source_file": "docs/01-arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IDs gerados na aplicacao pelo Hibernate, nao no banco; independente de fornecedor."}, {"id": "docs_01_arquitetura_fetchtype_eager", "label": "FetchType EAGER Explicito", "file_type": "rationale", "source_file": "docs/01-arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Evita LazyInitializationException na serializacao, ao custo de joins sempre presentes."}, {"id": "docs_01_arquitetura_dtos_em_vez_de_entidades", "label": "DTOs em vez de Entidades", "file_type": "rationale", "source_file": "docs/01-arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "O cliente nunca ve o grafo JPA; sem risco de recursao infinita no JSON e sem mass assignment."}, {"id": "docs_01_arquitetura_desnormalizacao_na_resposta", "label": "Desnormalizacao do Nome na Resposta", "file_type": "rationale", "source_file": "docs/01-arquitetura.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Os mappers achatam o nome da entidade relacionada (tutorNome, clinicaNome) dentro da resposta, poupando o cliente de uma segunda chamada."}], "edges": [{"source": "docs_01_arquitetura_arquitetura_em_camadas", "target": "docs_01_arquitetura_arquitetura_em_camadas", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/01-arquitetura.md", "source_location": null, "weight": 1.0}, {"source": "docs_01_arquitetura_arquitetura_em_camadas", "target": "docs_01_arquitetura_fluxo_de_requisicao", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/01-arquitetura.md", "source_location": null, "weight": 1.0}, {"source": "docs_01_arquitetura_arquitetura_em_camadas", "target": "docs_01_arquitetura_cache_caffeine", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/01-arquitetura.md", "source_location": null, "weight": 1.0}, {"source": "docs_01_arquitetura_arquitetura_em_camadas", "target": "docs_01_arquitetura_tratamento_global_de_erros", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/01-arquitetura.md", "source_location": null, "weight": 1.0}, {"source": "docs_01_arquitet