{"nodes": [{"id": "docs_04_configuracao_perfis_spring", "label": "Perfis Spring (oracle / h2 / dev)", "file_type": "concept", "source_file": "docs/04-configuracao.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "oracle e o perfil ativo por padrao: rodar mvn spring-boot:run sem sobrescrever tenta conectar no Oracle da FIAP."}, {"id": "docs_04_configuracao_flyway_migrations", "label": "Migrations Flyway", "file_type": "concept", "source_file": "docs/04-configuracao.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Um unico conjunto serve aos dois bancos: o H2 roda em MODE=Oracle. Os UUIDs do seed sao literais fixos, o que dispensa PL/SQL e da dados deterministicos aos testes."}, {"id": "docs_04_configuracao_baseline_version_2", "label": "Baseline Version 2", "file_type": "rationale", "source_file": "docs/04-configuracao.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bancos criados pelo antigo db-oracle.sql entram com V1 e V2 marcadas como aplicadas. Com baseline-version=1 o seed rodaria de novo e duplicaria os dados. Por isso a correcao do status_pagamento esta na V4, e nao na V1."}, {"id": "docs_04_configuracao_variaveis_de_ambiente", "label": "Variaveis de Ambiente Obrigatorias", "file_type": "concept", "source_file": "docs/04-configuracao.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JWT_SECRET, DB_USERNAME e DB_PASSWORD. Nenhuma credencial fica versionada: alem do risco em si, DevOps desconta 20 pontos por dados sensiveis no codigo-fonte."}, {"id": "docs_04_configuracao_precedencia_de_configuracao", "label": "Precedencia de Configuracao", "file_type": "concept", "source_file": "docs/04-configuracao.md", "source_location": null, "source_url": null, "captured_at": null, "auth