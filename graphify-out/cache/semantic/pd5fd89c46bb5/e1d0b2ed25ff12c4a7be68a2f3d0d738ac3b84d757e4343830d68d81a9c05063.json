{"nodes": [{"id": "docs_07_pendencias_e_divergencias_pendencias_e_divergencias", "label": "Pendencias e Divergencias", "file_type": "concept", "source_file": "docs/07-pendencias-e-divergencias.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Descolamentos entre codigo, schema do banco e documentacao. Dos 18 itens, restam 3 abertos (7, 9 e 12) e uma pendencia parcial (15)."}, {"id": "docs_07_pendencias_e_divergencias_reembolsado_vs_estornado", "label": "REEMBOLSADO vs ESTORNADO", "file_type": "concept", "source_file": "docs/07-pendencias-e-divergencias.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Severidade alta, resolvido pela migration V4. O enum declarava REEMBOLSADO e o check constraint aceitava ESTORNADO: o valor era impossivel de gravar no perfil oracle e estourava ORA-02290 como 500."}, {"id": "docs_07_pendencias_e_divergencias_credenciais_versionadas", "label": "Credenciais Oracle Versionadas", "file_type": "concept", "source_file": "docs/07-pendencias-e-divergencias.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Severidade alta, resolvido por DB_USERNAME/DB_PASSWORD. As credenciais permanecem no historico do Git mesmo apos a remocao do arquivo, entao a senha precisa ser trocada no Oracle."}, {"id": "docs_07_pendencias_e_divergencias_unicidade_so_no_banco", "label": "Unicidade so Existe no Banco", "file_type": "concept", "source_file": "docs/07-pendencias-e-divergencias.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolvido com 409 no handler. CPF duplicado passava pelo Bean Validation, estourava ORA-00001 e virava 500."}, {"id": "docs_07_pendencias_e_divergencias_exclusao_com_dependentes", "label": "Exclusao com Dependentes", "file_type": "concept", "source_file": "docs/07-pendencias-e-divergencias.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolvido com 409 e coberto por IntegridadeReferencialTest. Cascata automatica foi descartada: apagar um tutor nao deveria apagar o historico clinico do pet."}, {"id": "docs_07_pendencias_e_divergencias_escape_no_like", "label": "Filtros LIKE sem ESCAPE", "file_type": "concept", "source_file": "docs/07-pendencias-e-divergencias.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Severidade alta. Os filtros por texto nunca casavam por causa de LIKE ... ESCAPE ''; corrigido com ESCAPE '\\' explicito, mas falta confirmar no Oracle."}, {"id": "docs_07_pendencias_e_divergencias_tutorid_do_corpo", "label": "tutorId do Corpo sem Checagem", "file_type": "concept", "source_file": "docs/07-pendencias-e-divergencias.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Severidade alta. Um tutor autenticado cadastrava pet no nome de outro e podia transferir o proprio pet. Corrigido com @PreAuthorize no POST e no PUT."}, {"id": "docs_07_pendencias_e_divergencias_datapagamento_obrigatoria", "label": "dataPagamento Obrigatoria (aberto)", "file_type": "concept", "source_file": "docs/07-pendencias-e-divergencias.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Item 7, aberto. Impede registrar pagamento pendente, que no seed tem data_pagamento nula."}, {"id": "docs_07_pendencias_e_divergencias_cache_nao_invalida_entre_entidades", "label": "Cache nao Invalida entre Entidades (aberto)", "file_type": "concept", "source_file": "docs/07-pendencias-e-divergencias.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Item 9, aberto. Escrever num evento nao invalida o cache de animais."}, {"id": "docs_07_pendencias_e_divergencias_especie_e_porte_texto_livre", "label": "especie e porte como Texto Livre (aberto)", "file_type": "concept", "source_file": "docs/07-pendencias-e-divergencias.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Item 12, aberto. porte aceita qualquer string na aplicacao, mas o Oracle restringe a PEQUENO/MEDIO/GRANDE via check constraint."}, {"id": "docs_07_pendencias_e_divergencias_size_rejeita_o_seed", "label": "@Size Rejeita o Formato do Seed", "file_type": "concept", "source_file": "docs/07-pendencias-e-divergencias.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "crmv e telefone tinham limites mais estreitos que os dados reais: os registros do seed eram validos no banco mas nao podiam ser recriados pela API."}], "edges": [{"source": "docs_07_pendencias_e_divergencias_pendencias_e_divergencias", "target": "docs_07_pendencias_e_divergencias_reembolsado_vs_estornado", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/07-pendencias-e-divergencias.md", "source_location": null, "weight": 1.0}, {"source": "docs_07_pendencias_e_divergencias_pendencias_e_divergencias", "target": "docs_07_pendencias_e_divergencias_credenciais_versionadas", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/07-pendencias-e-divergencias.md", "source_location": null, "weight": 1.0}, {"source": "docs_07_pendencias_e_divergencias_pendencias_e_divergencias", "target": "docs_07_pendencias_e_divergencias_unicidade_so_no_banco", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/07-pendencias-e-divergencias.md", "source_location": null, "weight": 1.0}, {"source": "docs_07_pendencias_e_divergencias_pendencias_e_divergencias", "target": "docs_07_pen